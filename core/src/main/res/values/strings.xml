<?xml version="1.0" encoding="utf-8"?>
<!--
  Names shown on BOTH the phone and the watch, so they live in the shared module rather
  than being duplicated in each. Sect and madhab names stay in app/values/strings.xml
  because only the phone ever shows them.

  Translators: these are the most sensitive strings in the app. Prayer names are usually
  left as the Arabic transliteration even in translated apps (Urdu and Indonesian users
  expect "Fajr", not a local translation of "dawn"), so change them only on the advice of
  a native speaker. Calculation methods are the names of real organisations and mostly
  should not be translated at all.
-->
<resources>

    <!--
      Translators: nobody ever sees this one. It is the BCP-47 tag of the language this
      file is written in, and the app reads it back to decide how to format clock times,
      dates and numbers. Every translation must override it with its own tag, or it will
      show its own words with English number formatting. LocaleDisciplineTest fails the build
      if a translation forgets. See AppLocale.kt for why this exists at all.
    -->
    <string name="app_language_tag">en-GB</string>

    <string name="prayer_fajr">Fajr</string>
    <string name="prayer_sunrise">Sunrise</string>
    <string name="prayer_dhuhr">Dhuhr</string>
    <string name="prayer_asr">Asr</string>
    <string name="prayer_maghrib">Maghrib</string>
    <string name="prayer_isha">Isha</string>

    <string name="method_auto">Automatic</string>
    <string name="method_muslim_world_league">Muslim World League</string>
    <string name="method_egyptian">Egyptian General Authority</string>
    <string name="method_karachi">University of Karachi</string>
    <string name="method_umm_al_qura">Umm al-Qura, Makkah</string>
    <string name="method_dubai">Dubai</string>
    <string name="method_moon_sighting">Moonsighting Committee</string>
    <string name="method_north_america">ISNA, North America</string>
    <string name="method_kuwait">Kuwait</string>
    <string name="method_qatar">Qatar</string>
    <!--
      adhan's SINGAPORE preset: Fajr 20, Isha 18. Those angles are also Kemenag's in
      Indonesia and MUIS's in Singapore, so the label names both — "Singapore" alone was
      invisible to ~240 million Indonesians who had no reason to look at it.
      Verified against MUIS's OWN 2024 timetable (not an aggregator) on four dates: Subuh
      matches 20 degrees to within a minute and is 8-9 minutes from 18.

      Malaysia is deliberately NOT named here, and this must not be "corrected" back.
      JAKIM used 20 degrees until the MKI Coordination Committee of 20-21 Nov 2019 moved
      the national criterion to 18, making Subuh about 8 minutes later. Malaysia is
      therefore served by Muslim World League, not by this entry. Aladhan's JAKIM method
      still publishes 20 and is stale; an earlier version of this label trusted it and was
      wrong. See docs/HANDOVER.md §10, "Aladhan was stale and I shipped it".
    -->
    <string name="method_singapore">Kemenag &amp; MUIS, Indonesia and Singapore</string>
    <string name="method_turkey">Diyanet, Turkey</string>
    <string name="method_jafari">Jafari (Ithna Ashari)</string>
    <string name="method_tehran">Institute of Geophysics, Tehran</string>

    <!--
      One plain sentence or two under each method, shown wherever the list is offered (the
      Settings picker and the first-run step). A list of institution names means nothing to
      most people, and the wrong pick moves Isha by an hour in the north.

      Rules for these, because they are religious content and were got wrong once before
      (see the Malaysia note above):
        - No angles, no degrees. The person this list is for does not think in solar
          depression, and the ones who do can read docs/ARCHITECTURE.md.
        - Say WHO publishes the method. Say WHERE it is used only where that is either the
          publishing body's own country or has been verified against real timetables
          (Indonesia and Singapore against MUIS's own PDF and Kemenag's statement; Britain
          against two mosques' published tables, docs/HANDOVER.md §10 "Isha in the UK").
          "Common in" and "some mosques" are deliberate hedges, not filler. Do not upgrade
          them to "the method for" without the authority's own document.
        - Never sell one as "the method for your country" when a country has several
          (Britain, the United States and Indonesia all do). The user is told to ask their
          mosque, and these lines exist to help them recognise the answer.
      Translators: keep the hedges. "Some" and "many" are load-bearing.
    -->
    <string name="method_auto_desc">Not sure? Keep this. Muslim World League times, or Jafari for Shia. Close to local practice in much of the world. The far north differs most.</string>
    <string name="method_muslim_world_league_desc">A general convention used in many countries. The standard here.</string>
    <string name="method_egyptian_desc">Egypt\'s official method.</string>
    <string name="method_karachi_desc">Common across Pakistan and South Asia.</string>
    <string name="method_umm_al_qura_desc">The official method in Saudi Arabia. Isha is set at a fixed time after Maghrib.</string>
    <string name="method_dubai_desc">A convention used in the Gulf.</string>
    <string name="method_moon_sighting_desc">A seasonal rule made for places far from the equator. Followed by some mosques in Britain.</string>
    <string name="method_north_america_desc">The Islamic Society of North America. Used by many mosques in the United States and Canada.</string>
    <string name="method_kuwait_desc">The convention used in Kuwait.</string>
    <string name="method_qatar_desc">The convention used in Qatar.</string>
    <string name="method_singapore_desc">The official bodies of Indonesia and Singapore.</string>
    <string name="method_turkey_desc">Turkey\'s Presidency of Religious Affairs.</string>
    <string name="method_jafari_desc">The usual Shia convention. Maghrib is a little after sunset, once the redness has left the sky.</string>
    <string name="method_tehran_desc">The University of Tehran, whose calendar Iran\'s official times follow.</string>

</resources>
