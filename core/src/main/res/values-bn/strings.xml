    <!-- Religious content: keep the hedges ("many", "some", "common"). No angles, no degrees. -->
    <string name="method_auto_desc">নিশ্চিত নন? এটিই রাখুন। মুসলিম ওয়ার্ল্ড লীগের সময়, বা শিয়াদের জন্য জাফরি। বিশ্বের অনেক জায়গায় স্থানীয় প্রচলনের কাছাকাছি। সুদূর উত্তরে পার্থক্য সবচেয়ে বেশি।</string>
    <string name="method_muslim_world_league_desc">অনেক দেশে ব্যবহৃত একটি সাধারণ পদ্ধতি। এই অ্যাপে এটিই ডিফল্ট।</string>
    <string name="method_egyptian_desc">মিশরের সরকারি পদ্ধতি।</string>
    <string name="method_karachi_desc">পাকিস্তান ও দক্ষিণ এশিয়ায় প্রচলিত।</string>
    <string name="method_umm_al_qura_desc">সৌদি আরবের সরকারি পদ্ধতি। এশা মাগরিবের পর একটি নির্দিষ্ট সময়ে ধরা হয়।</string>
    <string name="method_dubai_desc">উপসাগরীয় অঞ্চলে ব্যবহৃত একটি পদ্ধতি।</string>
    <string name="method_moon_sighting_desc">বিষুবরেখা থেকে দূরের জায়গার জন্য তৈরি ঋতুভিত্তিক নিয়ম। ব্রিটেনের কিছু মসজিদ এটি মেনে চলে।</string>
    <string name="method_north_america_desc">ইসলামিক সোসাইটি অব নর্থ আমেরিকা। যুক্তরাষ্ট্র ও কানাডার অনেক মসজিদে ব্যবহৃত।</string>
    <string name="method_kuwait_desc">কুয়েতে প্রচলিত পদ্ধতি।</string>
    <string name="method_qatar_desc">কাতারে প্রচলিত পদ্ধতি।</string>
    <string name="method_singapore_desc">ইন্দোনেশিয়া ও সিঙ্গাপুরের সরকারি সংস্থা।</string>
    <string name="method_turkey_desc">তুরস্কের ধর্ম বিষয়ক অধিদপ্তর, তাদের সতর্কতামূলক বাড়তি মিনিটসহ।</string>
    <string name="method_jafari_desc">শিয়াদের প্রচলিত পদ্ধতি। মাগরিব সূর্যাস্তের একটু পরে, যখন আকাশের লালিমা চলে যায়।</string>
    <string name="method_tehran_desc">তেহরান বিশ্ববিদ্যালয়, যার ক্যালেন্ডার অনুযায়ী ইরানের সরকারি সময় ঠিক হয়।</string>
</resources>
