<?xml version="1.0" encoding="utf-8"?>
<!--
  Today: the default placement is 4 cells by 3 (Ali, 4 Nov 2026). At 4 by 4 the emulator's launcher opened a tall 3 by 5 slot, and the large
  card left an empty band under the rows; the owner does not want a taller widget by default. The real floor is minHeight 240dp (a larger
  minResizeHeight is ignored by launchers). Since 1.7.1 one layout in two forms (WidgetRenderer.todayForms, measured per text size and
  language): the list with 1 to 6 rows (six from 278dp at a 300dp width, 303 at 245), and the card with the countdown from about 553dp
  at normal text. No previewLayout since 1.7.1: with no data the layout is an empty card, so the picker shows the picture.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_today_desc"
    android:initialLayout="@layout/widget_today"
    android:minWidth="250dp"
    android:minHeight="240dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="240dp"
    android:previewImage="@drawable/widget_preview_today"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
