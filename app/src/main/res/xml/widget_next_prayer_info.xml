<?xml version="1.0" encoding="utf-8"?>
<!--
  Next prayer, Android 11 and below: a launcher takes ONE layout there (the short card: name, time, countdown, town chip), so the slot is
  110dp, 2 cells tall, as before 1.7.0. Android 12 and up use res/xml-v31/widget_next_prayer_info.xml (one row by default, the card adapts
  from a one-line form up to the wide card with the day beside the countdown). updatePeriodMillis is 0 on purpose: the system's own periodic
  update uses a waking alarm, which this app will not pay for a display. WidgetRefreshScheduler moves the widget on instead.
-->
<!-- Android 11 and below (a launcher takes ONE layout there, the short card, so the slot must hold it: 110dp, as before 1.7.0). Android 12 and up use
     res/xml-v31/widget_next_prayer_info.xml: one row by default, the card adapts down to a one-line form. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_next_desc"
    android:initialLayout="@layout/widget_next_prayer"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_preview_next"
    android:previewLayout="@layout/widget_next_prayer"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
