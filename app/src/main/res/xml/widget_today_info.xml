<?xml version="1.0" encoding="utf-8"?>
<!--
  Today, Android 11 and below: a launcher takes ONE layout there (the compact list with all six rows, 286dp at normal text), so the slot is
  290dp, as it was set on 4 Nov 2026. Android 12 and up use res/xml-v31/widget_today_info.xml (floor 240dp, the list adapts from 2 to 6 rows).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_today_desc"
    android:initialLayout="@layout/widget_today"
    android:minWidth="250dp"
    android:minHeight="290dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="290dp"
    android:previewImage="@drawable/widget_preview_today"
    android:previewLayout="@layout/widget_today"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
