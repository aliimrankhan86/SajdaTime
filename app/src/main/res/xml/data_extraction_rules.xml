<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may leave the device, and that has to remain true on
  Android 12 and above.

  android:allowBackup="false" is not enough on its own any more. From API 31 it
  only stops cloud backup; on many manufacturers' devices it leaves
  device-to-device transfer switched on, so the cached coordinates in DataStore
  would still be copied out when the user sets up a new phone. That is a real
  transfer of location data off the device, and the privacy policy says it never
  happens. So both channels are excluded explicitly here.

  allowBackup="false" stays in the manifest because this file is ignored on
  Android 11 and below.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
