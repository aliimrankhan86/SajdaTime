<?xml version="1.0" encoding="utf-8"?>
<!-- The languages the app may be switched to (Android 13 per-app language). Must list the same
     tags as AppLanguage.kt; LanguagePickerTest checks. A language here without a reviewed
     values-<tag>/ folder is harmless: AppLocale keeps the app in English, left to right. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ur" />
    <locale android:name="tr" />
    <locale android:name="id" />
</locale-config>
