<?xml version="1.0" encoding="utf-8"?>
<!-- The Today widget's town chip (1.7.1): a pill with a 1.5dp primary outline and no fill, so it reads as something to press
     on every sky without the words "Tap to". The town in primary on the sky is held to AA by WidgetColorsTest. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.5dp" android:color="@color/widget_primary" />
    <corners android:radius="100dp" />
</shape>
