<?xml version="1.0" encoding="utf-8"?>
<!-- The town chip and the highlight band behind the current row on the larger widgets (1.7.0), all on a sky body: the highlight fill is the
     same mint as the day sky (1.0:1), so a 1dp green rim keeps the container visible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_highlight" />
    <stroke android:width="1dp" android:color="@color/widget_primary" />
    <corners android:radius="12dp" />
</shape>
