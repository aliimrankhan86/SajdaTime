<?xml version="1.0" encoding="utf-8"?>
<!-- A copy of widget_row_highlight.xml with each colour fixed to its dark value, for a widget whose theme
     is chosen in the app (Settings, Theme). WidgetColorsTest fails the build if the two drift. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_dark_highlight" />
    <corners android:radius="12dp" />
</shape>
