<?xml version="1.0" encoding="utf-8"?>
<!-- Isha: full night, a crescent and one star. The moon is used only here, where it literally means night. Drawn white and tinted by the ImageView in the layout, so the launcher resolves the colour at
     each draw and the glyph follows the phone's dark mode (lesson 130). Shared by both widgets. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:autoMirrored="false"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M17,16.5A7,7 0,0 1,8.5,6A7,7 0,1 0,17,16.5Z"
        android:strokeWidth="1.8"
        android:strokeAlpha="1"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M18,3.5V6.5M16.5,5H19.5"
        android:strokeWidth="1.5"
        android:strokeAlpha="1"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
