<?xml version="1.0" encoding="utf-8"?>
<!-- widget_background.xml with the body gradient fixed to its dark value: the same sheen and rim. The Next prayer widget's body
     (1.6 step 8), chosen at each render from WidgetState.period. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/widget_dark_sky_dawn_mid"
                android:centerY="0.55"
                android:endColor="@color/widget_dark_sky_foot"
                android:startColor="@color/widget_dark_sky_dawn_top"
                android:type="linear" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:centerY="0.45"
                android:endColor="@android:color/transparent"
                android:startColor="@color/widget_dark_sheen"
                android:type="linear" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/widget_dark_edge" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
</layer-list>
