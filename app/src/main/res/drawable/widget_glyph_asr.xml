<?xml version="1.0" encoding="utf-8"?>
<!-- Asr: a low sun, a post, and a shadow the same length as the post, which is the Asr rule itself (the majority rule; Hanafi is twice the length, and one glyph serves both, the recommended default of 18 Oct 2026 that the owner did not object to). Drawn white and tinted by the ImageView in the layout, so the launcher resolves the colour at
     each draw and the glyph follows the phone's dark mode (lesson 130). Shared by both widgets. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:autoMirrored="false"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M8,6A2.5,2.5 0,1 1,3,6A2.5,2.5 0,1 1,8,6ZM3,20H21M10,20V13"
        android:strokeWidth="1.8"
        android:strokeAlpha="1"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M10,20H17"
        android:strokeWidth="3"
        android:strokeAlpha="0.55"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
