<?xml version="1.0" encoding="utf-8"?>
<!-- A copy of widget_pill_sky.xml with each colour fixed to its dark value, for a widget whose theme
     is chosen in the app (Settings, Theme). WidgetThemeTest fails the build if the two drift. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_dark_highlight" />
    <stroke android:width="1dp" android:color="@color/widget_dark_primary" />
    <corners android:radius="12dp" />
</shape>
