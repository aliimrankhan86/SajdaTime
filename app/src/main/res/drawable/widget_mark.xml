<?xml version="1.0" encoding="utf-8"?>
<!--
  The SajdaTime mark (the launcher icon's mihrab and minarets) on its green tile, for the Today
  widget's header and its "set your location" state only. Not on the small widgets: a mark there costs
  the prayer name its room, and Apple's widget guidance is not to spend a widget's space on branding.

  The two colours are written out, not theme roles, exactly as in ic_launcher_foreground.xml and
  ic_launcher_background.xml: this is the app's icon, which looks the same in light and dark, so it is
  depictive and is not resolved per theme. Same paths as ic_launcher_foreground.xml, scaled into a
  64 unit tile. Move all three together in the planned icon refresh (DESIGN_SYSTEM.md section 9).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
