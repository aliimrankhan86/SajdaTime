        android:fillColor="#0E6B4F"
        android:pathData="M16,0H48A16,16 0,0 1,64,16V48A16,16 0,0 1,48,64H16A16,16 0,0 1,0,48V16A16,16 0,0 1,16,0Z" />
    <group
