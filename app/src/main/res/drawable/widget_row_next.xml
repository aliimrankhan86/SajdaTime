<?xml version="1.0" encoding="utf-8"?>
<!-- The Today widget's next prayer row (1.7.1): primaryContainer fill and a 3dp primary bar on the leading edge. "start"
     follows the row's layout direction, so the bar is on the right in Urdu and Arabic. The bar is inset 10dp top and bottom so it
     stays inside the fill's rounded corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_highlight" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:bottom="10dp"
        android:gravity="start|fill_vertical"
        android:top="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_primary" />
            <corners android:radius="1.5dp" />
        </shape>
    </item>
</layer-list>
