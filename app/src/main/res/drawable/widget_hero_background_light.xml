<?xml version="1.0" encoding="utf-8"?>
<!-- A copy of widget_hero_background.xml with each colour fixed to its light value, for a widget whose theme
     is chosen in the app (Settings, Theme). WidgetThemeTest fails the build if the two drift. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/widget_light_hero_mid"
        android:endColor="@color/widget_light_hero_foot"
        android:startColor="@color/widget_light_hero_top"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/widget_light_outline_variant" />
    <corners android:radius="22dp" />
</shape>
