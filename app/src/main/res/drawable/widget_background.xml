<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget surface, glossy (owner's request, 18 Oct 2026; DESIGN_SYSTEM.md section 4, widgets).
  Three layers: a fixed top to bottom gradient, a sheen of white over the top half that fades out, and
  a rim. Every colour is a resource, resolved by the launcher at each draw, so the finish follows the
  phone's dark mode at once (lesson 130). WidgetColorsTest checks the text against every stop and
  against the top stop under the sheen.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/widget_surface"
                android:endColor="@color/widget_surface_bottom"
                android:startColor="@color/widget_surface_top"
                android:type="linear" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:centerY="0.45"
                android:endColor="@android:color/transparent"
                android:startColor="@color/widget_sheen"
                android:type="linear" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/widget_edge" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
</layer-list>
