<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">SajdaTime</string>

    <!-- Onboarding -->
    <string name="bismillah_arabic">بِسْمِ ٱللَّٰهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ</string>
    <string name="welcome_tagline">Your private prayer companion — always free.</string>
    <string name="action_begin">Begin</string>

    <string name="permission_title">Where are you praying?</string>
    <string name="permission_body">SajdaTime needs your approximate location to work out accurate prayer times. Tap the info icon to see exactly what this means.</string>
    <string name="permission_why_title">Why we need your location</string>
    <string name="permission_why_body">To show you accurate prayer times for where you are.\n\nWe only check your approximate location while the app is open. It never leaves your phone. No tracking, ever.</string>
    <string name="action_allow_location">Allow location</string>
    <string name="action_got_it">Got it</string>
    <string name="action_continue">Continue</string>
    <string name="location_set_generic">Your location</string>
    <string name="location_finding">Finding your location…</string>
    <string name="location_no_fix">We could not get a location fix. Check that location is switched on, or enter your city below.</string>

    <string name="city_fallback_heading">Prefer not to share your location?</string>
    <string name="city_fallback_body">Type your city instead. This sends only the city name you type to the free Aladhan service, once, to look up its coordinates. Every prayer time after that is calculated on your phone.</string>
    <string name="city_field_label">City</string>
    <string name="city_field_helper">For example: Manchester, Lahore, Cairo</string>
    <string name="city_not_found">We could not find that place. Try adding the country.</string>
    <string name="action_find_city">Find city</string>

    <string name="sect_title">Which school do you follow?</string>
    <string name="sect_body">This sets the calculation your prayer times are based on. You can change it any time in Settings.</string>
    <string name="sect_sunni">Sunni</string>
    <string name="sect_sunni_desc">Muslim World League calculation by default</string>
    <string name="sect_shia">Shia</string>
    <string name="sect_shia_desc">Jafari (Ithna Ashari) calculation</string>

    <string name="madhab_title">Select your madhab</string>
    <string name="madhab_body">Optional. This only affects the Asr time. Skip it and you will get the standard calculation.</string>
    <string name="madhab_hanafi">Hanafi</string>
    <string name="madhab_shafii">Shafi\'i</string>
    <string name="madhab_maliki">Maliki</string>
    <string name="madhab_hanbali">Hanbali</string>
    <string name="madhab_hanafi_desc">Later Asr (shadow twice the object\'s length)</string>
    <string name="madhab_standard_desc">Standard Asr (shadow equal to the object\'s length)</string>
    <string name="action_skip">Skip</string>
