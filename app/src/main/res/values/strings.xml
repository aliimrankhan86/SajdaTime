    <!--
      Hijri month names are listed here rather than left to the platform. Month name data
      for the Islamic chronology is missing or numeric on many Android versions, which
      renders the date as "16 2 1448". Listing them also makes them translatable.
    -->
    <string name="hijri_date_format">%1$d %2$s %3$d</string>
