    <string name="location_finding">Finding your location…</string>
    <string name="location_no_fix">We could not get a fix. Check that location is turned on, or type your city below.</string>

    <string name="city_fallback_heading">Rather not share your location?</string>
    <string name="city_fallback_body">Type your city instead. Your phone looks it up on its own where it can. If it cannot, just the name you typed is sent once to a free lookup service. After that, everything is worked out on your phone.</string>
    <string name="city_field_label">City</string>
