    <!--
      Hijri month names are listed explicitly rather than left to the platform. Month
      name data for the Islamic chronology is missing or numeric on many Android
      versions, which renders the date as "16 2 1448". Listing them also makes the
      names translatable.
    -->
    <string name="hijri_date_format">%1$d %2$s %3$d</string>
    <string-array name="hijri_months">
        <item>Muharram</item>
        <item>Safar</item>
        <item>Rabi al-Awwal</item>
        <item>Rabi al-Thani</item>
        <item>Jumada al-Ula</item>
        <item>Jumada al-Akhirah</item>
        <item>Rajab</item>
        <item>Shaban</item>
        <item>Ramadan</item>
        <item>Shawwal</item>
        <item>Dhu al-Qadah</item>
        <item>Dhu al-Hijjah</item>
    </string-array>

