<?xml version="1.0" encoding="utf-8"?>
<!--
  The Next prayer widget, 3 cells by 2. No android:text anywhere, on purpose: a RemoteViews layout is
  inflated by the launcher, which would resolve @string/ in the PHONE's language and not the app's.
  Every word is set from WidgetRenderer through AppLocale.wrap. WidgetResourcesTest fails the build if
  one slips in, and it fails if a class RemoteViews may not inflate (a plain View, for one) does.

  Colours are resolved by the launcher each time it draws, so the widget follows the phone's dark mode
  the moment the phone changes it. Children are hidden from accessibility: the root carries one spoken
  sentence for the whole widget.

  A vertical stack in order of importance: the prayer, its time, one small line of context, the
  countdown. When a larger font does not fit, it is the lines at the bottom that are clipped and never
  the prayer or its time. The context line holds "Tomorrow", the Ramadan word or the approximate
  marker, joined when more than one applies, which is the usual case after Isha in Ramadan. Four
  lines fit 110dp at the normal font size, checked by rendering it. It is 3 cells wide, not 2, so the
  prayer name and the time each stay on one line at 200 percent text size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_on_surface"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_sublabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_primary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
