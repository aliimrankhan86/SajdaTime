                android:layout_height="5dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seg_todo"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/widget_seg_2"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seg_todo"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/widget_seg_3"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seg_todo"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/widget_seg_4"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seg_todo"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/widget_seg_5"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seg_todo"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <ImageView
