<?xml version="1.0" encoding="utf-8"?>
<!--
  The Next prayer widget, wide: from 270 by 150dp on Android 12 and later (WidgetRenderer.NEXT_SIZES).
  The small widget's countdown block on the start side (the time on its own line under the name, where
  beside it the name left it no room), and the whole day on the end side, the six rows
  spread over the height. The rows use the Today widget's ids, so one function fills both. Their
  label column is left empty here: at this width the bold, highlighted row already says which is next,
  and "Suhoor ends" would not fit beside the time. Not used at 130 percent text or more, where the
  times no longer fit beside the countdown (WidgetRenderer.responsive).

  Rules for every widget layout (WidgetResourcesTest fails the build on each): no android:text, because
  the launcher would resolve it in the PHONE's language; only classes a RemoteViews may inflate (no plain
  View, so hairlines and progress bars are ImageViews with a drawable); every text view hidden from
  TalkBack, the root carries one spoken sentence; every colour a resource, resolved by the launcher at
  each draw so the widget follows the phone's dark mode. Glyphs are drawn white and tinted here, for the
  same reason (lesson 130).

  The countdown is set in the light weight, Apple Clock style, and its size is written from
  WidgetRenderer in dp rather than sp: it is already about three times the body text, and scaled by a
  large font setting it pushed the prayer name off a 110dp widget. Names and times stay in sp.

  tools:ignore on the root, all three deliberate: the empty weighted LinearLayouts are the gaps that
  spread the content (HANDOVER lesson 142), the nested weight is the wide layout's two columns, and a
  compound drawable cannot be tinted per theme from a layout the way an ImageView's glyph is.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp"
    tools:ignore="UselessLeaf,NestedWeights,UseCompoundDrawables">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_glyph"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_glyph_fajr"
                android:tint="@color/widget_primary" />
            <TextView
                android:id="@+id/widget_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface"
            android:textSize="34sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_hero_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface"
            android:textSize="34sp"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/widget_place_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:gravity="center_vertical"
                android:importantForAccessibility="yes"
                android:minHeight="24dp"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_icon_pin"
                    android:tint="@color/widget_primary" />
                <TextView
                    android:id="@+id/widget_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxWidth="120dp"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_icon_update"
                    android:tint="@color/widget_primary" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_sublabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <ImageView
