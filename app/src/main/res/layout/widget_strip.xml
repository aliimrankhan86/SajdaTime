<?xml version="1.0" encoding="utf-8"?>
<!--
  The five prayer columns use one measured text size. When they cannot fit at 14sp, the strip
  shows one prayer instead. The app mark sits at the start in either layout and mirrors in RTL.
  The root supplies the accessible summary.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp"
    tools:ignore="UnusedAttribute">
    <LinearLayout
        android:id="@+id/widget_strip_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_glyph"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_mark" />
        <TextView
            android:id="@+id/widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_sublabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_strip_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_strip_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_mark" />
        <LinearLayout
            android:id="@+id/widget_row_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
                        android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_name_fajr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:importantForAccessibility="no"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
            <ImageView
                android:id="@+id/widget_glyph_fajr"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_glyph_fajr"
                android:tint="@color/widget_on_surface_variant" />
            <TextView
                android:id="@+id/widget_time_fajr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_row_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
                        android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_name_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:importantForAccessibility="no"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
            <ImageView
                android:id="@+id/widget_glyph_dhuhr"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_glyph_dhuhr"
                android:tint="@color/widget_on_surface_variant" />
            <TextView
                android:id="@+id/widget_time_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_row_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
                        android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_name_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:importantForAccessibility="no"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
            <ImageView
                android:id="@+id/widget_glyph_asr"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_glyph_asr"
                android:tint="@color/widget_on_surface_variant" />
            <TextView
                android:id="@+id/widget_time_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_row_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
                        android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_name_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:importantForAccessibility="no"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
            <ImageView
                android:id="@+id/widget_glyph_maghrib"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_glyph_maghrib"
                android:tint="@color/widget_on_surface_variant" />
            <TextView
                android:id="@+id/widget_time_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_row_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
                        android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_name_isha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:importantForAccessibility="no"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
            <ImageView
                android:id="@+id/widget_glyph_isha"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_glyph_isha"
                android:tint="@color/widget_on_surface_variant" />
            <TextView
                android:id="@+id/widget_time_isha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/widget_place_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_chip"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:minHeight="24dp"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_place_pin"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_icon_pin"
                android:tint="@color/widget_primary" />
            <TextView
                android:id="@+id/widget_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxWidth="56dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widget_place_update"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginStart="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_icon_update"
                android:tint="@color/widget_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
