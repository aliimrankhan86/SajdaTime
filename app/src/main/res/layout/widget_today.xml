            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_glyph_fajr"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_glyph_fajr"
                android:tint="@color/widget_on_surface_variant" />
            <ImageView
                android:id="@+id/widget_logo_fajr"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_mark"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_on_surface"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/widget_label_fajr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/widget_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAlignment="viewEnd"
                android:textColor="@color/widget_on_surface"
                android:textSize="16sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_row_underline_fajr"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="-4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_underline"
            android:scaleType="fitXY"
            android:visibility="gone" />
    </FrameLayout>
