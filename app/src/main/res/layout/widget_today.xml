    <!-- Footer sits right under the rows; spare height falls at the bottom edge as ordinary card padding, not as a
         hole between Isha and the location (Ali, 4 Nov 2026, Redmi 4x4: "too many spacing in between"). -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- No mark here: the current prayer's row already carries it. The footer is the location chip and the countdown,
             one line, so the chip is not cut at the bottom of the card (Ali, 4 Nov 2026: cleaner and easier to read). -->
        <LinearLayout
            android:id="@+id/widget_place_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:minHeight="22dp"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_place_pin"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_icon_pin"
                android:tint="@color/widget_primary" />
