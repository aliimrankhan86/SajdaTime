        android:paddingEnd="8dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="4"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- No spacer above the rows: an empty band here (10dp padding plus a weighted spacer) showed as a gap above Fajr
         on the Redmi's 4x4 slot (4 Nov 2026). The spare height now sits in the one spacer above the footer. -->
    <!-- Row padding is rewritten on every render by WidgetRenderer.fillRows (marked row 4dp below, others 0), so the values here are only the first paint. Each row has clipToPadding false and its underline layout_marginBottom -4dp so the bar sits in that padding, under the text. -->
