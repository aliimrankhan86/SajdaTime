<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Approximate location only. Never "fine", never "background" - prayer times shift by
      well under a minute across a coarse-location cell, so precision buys nothing and
      costs privacy.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Two uses. The one-off city lookup when location is declined, and, only if the user
      opts in, anonymous-ID usage counts sent to Google Analytics (docs/ANALYTICS_PLAN.md).
      Nothing is sent to Google Analytics until the user says yes.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Added by the Firebase Analytics library and deliberately removed: this app shows no
      ads and does not use the advertising ID or Privacy Sandbox ad attribution. Removing
      them keeps the Play "Advertising ID" answer at No. tools:node="remove" is the
      documented way (developers.google.com/android/reference/com/google/android/gms/ads/identifier/AdvertisingIdClient.Info).
      A guard test fails the build if any of these returns to the merged manifest source.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Prayer alerts must land on the minute. Denied by default from Android 13, and
      setAlarmClock requires it too, so there is no exact path without it. When it is
      not granted the scheduler falls back to setAndAllowWhileIdle, which fires within
      a few minutes rather than on the minute. Settings shows a banner offering to
      grant it.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Lets the user put SajdaTime on the system's "Do Not Disturb access" list (Samsung calls
      it "Do Not Disturb permission"). Settings' "Allow sound during Do Not Disturb" button
      opens that list, and Android only lists apps that declare this permission
      (ZenAccessController.getPackagesRequestingNotificationPolicyAccess in AOSP Settings).
      1.3.1 shipped the button without it, so the list never contained the app: the owner
      found that on his Samsung on 10 Oct 2026.

      It is an install-time permission: no prompt, no Play declaration, and it grants nothing
      by itself. Access is off until the user switches it on in that list. The only thing the
      app does with it is let its own prayer alarm channel bypass Do Not Disturb
      (Notifications.ensureAlarmChannel). It never changes the phone's Do Not Disturb state.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!--
      Backup is off deliberately. Cloud backup would copy the user's cached coordinates
      to Google's servers, which directly contradicts the promise that their location
      never leaves the device. Settings are two taps to re-enter; the privacy guarantee
      is worth more.

      allowBackup covers Android 11 and below. From Android 12 it stops cloud backup but
      not device-to-device transfer, so data_extraction_rules.xml shuts both off there.
    -->
    <!--
      Stated rather than left to the default. Cleartext is already off for targetSdk 28 and
      above, but that is a default, and defaults are what a future library's merged manifest
      quietly changes. The one request this app makes is HTTPS; saying so here means an
      accidental http:// endpoint fails loudly instead of working.
    -->
    <!--
      Usage counts: Firebase starts with the app but is told NOT to collect. It is enabled
      only when the user opts in (data/UsageCounts.kt), and that choice is re-applied each
      launch. Do not use firebase_analytics_collection_deactivated: it would block the
      opt-in. Advertising ID collection is off. Automatic screen views are off so only the
      fixed set of events in docs/ANALYTICS_PLAN.md section 4.3 is ever sent.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SajdaTime">

        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SajdaTime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sajdatime.app.action.PRAYER_ALARM" />
                <action android:name="com.sajdatime.app.action.SUHOOR_REMINDER" />
            </intent-filter>
        </receiver>

        <!--
          The two home screen widgets. exported="false" is what the current Android Studio template
          generates: the system, not another app, sends APPWIDGET_UPDATE. ASSUMED until the widget
          device test has run on the API 36 emulator; if a provider is never updated there, flip it to
          true and record why. updatePeriodMillis is 0 in both provider files on purpose.
        -->
        <receiver
            android:name=".widget.NextPrayerWidgetProvider"
            android:exported="false"
            android:label="@string/widget_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_prayer_info" />
        </receiver>

        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".notify.SystemEventReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Android 12+: "Alarms & reminders" granted or revoked. See
                     SystemEventReceiver for why both directions need a reschedule. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
