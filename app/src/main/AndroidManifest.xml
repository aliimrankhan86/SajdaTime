<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Approximate location only. Never "fine", never "background" - prayer times shift by
      well under a minute across a coarse-location cell, so precision buys nothing and
      costs privacy.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Used solely for the one-off city lookup when location is declined. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Prayer alerts must land on the minute. Denied by default from Android 13, and
      setAlarmClock requires it too, so there is no exact path without it. When it is
      not granted the scheduler falls back to setAndAllowWhileIdle, which fires within
      a few minutes rather than on the minute. Settings shows a banner offering to
      grant it.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!--
      Backup is off deliberately. Cloud backup would copy the user's cached coordinates
      to Google's servers, which directly contradicts the promise that their location
      never leaves the device. Settings are two taps to re-enter; the privacy guarantee
      is worth more.

      allowBackup covers Android 11 and below. From Android 12 it stops cloud backup but
      not device-to-device transfer, so data_extraction_rules.xml shuts both off there.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SajdaTime">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SajdaTime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sajdatime.app.action.PRAYER_ALARM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notify.SystemEventReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
