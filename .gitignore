*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
/captures/
.externalNativeBuild
.cxx
local.properties

# Gradle build output
build/
app/build/

# Kotlin
.kotlin/

# macOS iCloud Drive conflict copies. The project used to live under ~/Documents, which
# iCloud syncs; it wrote "<name> 2.class" duplicates into the build directory and broke
# dexing three times. It now lives in ~/Developer. This stays as a second line of defence
# in case anyone moves it back into a synced folder.
*\ [0-9].*

# Signing. Contains the upload key password - never commit.
keystore.properties
*.jks
*.keystore

# Scratch output from the designlang CLI. Competitor design extractions are
# working notes, not part of the app.
design-extract-output/

# Python bytecode. tools/*.py get imported by ad-hoc analysis scripts during verification,
# which drops a __pycache__ next to them. Twice now it has turned up in git status.
__pycache__/
*.pyc

# JVM crash dumps. The Gradle daemon can die under memory pressure — running two
# emulators alongside a 4GB daemon did it once — and drops these in the repo root.
hs_err_pid*.log
replay_pid*.log

# Knowledge graph built by the `graphify` CLI over this repo. 6MB of generated artefacts
# (a 1.9MB graph.json and a 1.6MB self-contained graph.html), regenerable in one command,
# and the cache files inside it hold absolute paths from whichever machine built them.
# Nothing in it is a source of truth — anything worth keeping gets written into
# docs/HANDOVER.md by hand, which is where the next session will actually look.
graphify-out/

# Per-machine Claude Code settings (.claude/settings.local.json). Local tool permissions
# for whoever is sitting at this checkout, not a property of the project, and committing
# one machine's answers would silently apply them to the next session on another machine.
.claude/
